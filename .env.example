# Comments must be on their own line: `KEY=   # comment` makes the comment the value.
# Secrets (tokens, keys) must be at least 32 random characters, e.g.:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Core ---
# how Claude's prompts refer to you (the single user); neutral default if unset
OWNER_NAME=the owner
ORBIT_URL=https://orbit.example.com
ORBIT_API_TOKEN=change-me-long-random
# argon2 hash, single-quoted (it contains `$`); generate with: uv run python -m orbit.cli hash-password
ORBIT_WEB_PASSWORD_HASH=
# session cookies + signed action tokens
ORBIT_SECRET_KEY=change-me
ICS_TOKEN=change-me-long-random
# optional: a token that can only call /api/v1/review-agent/* (a weekly review made by Claude Code
# on the server with a subscription, docs/DEPLOY.md); generate like the others
ORBIT_REVIEW_TOKEN=
# optional: a read-only token that opens only GET /api/v1/context, for the MCP server (docs/MCP.md)
ORBIT_MCP_TOKEN=
TIMEZONE=Europe/Prague
# dev; docker-compose.prod.yml sets its own (Postgres)
DATABASE_URL=sqlite:///./orbit.db
SESSION_MAX_AGE_DAYS=30
# in-process scheduler (queued pushes, reminders); keep it on in exactly one app process
SCHEDULER_ENABLED=true

# --- Claude ---
# Production leaves the key empty: every Claude question goes to the Claude Code worker on the server
# (docs/DEPLOY.md step 10, SPEC §2.18 and §2.19). Set key and model only to use the pay-per-token API instead.
ANTHROPIC_API_KEY=
# set to the current model id you want to use
ANTHROPIC_MODEL=
# optional, API path only: a faster model for meeting links, bank row sorting and briefs, and a deeper one for the
# weekly review and reports (empty: the model above). The deep model thinks (adaptive) at this effort; "off" for a model without thinking.
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_DEEP=
ANTHROPIC_DEEP_EFFORT=high
# who answers Claude's questions: auto (api if the key is set, else worker if ORBIT_REVIEW_TOKEN is set), api, worker, none
CLAUDE_BACKEND=auto
# overrides the line above: auto (use CLAUDE_BACKEND), fake (offline canned answers for demos and CI), api, worker
ORBIT_CLAUDE_MODE=auto
# demo instance: with mode auto and no API key or worker, use the offline fake Claude (`seed-demo` prints this)
ORBIT_DEMO=false
# worker backend: how long a request waits for the worker before it falls back (seconds), queue limits, retention
CLAUDE_WAIT_INTERACTIVE_SECONDS=45
CLAUDE_WAIT_BACKGROUND_SECONDS=120
CLAUDE_QUEUE_CAP_INTERACTIVE=10
CLAUDE_QUEUE_CAP_BACKGROUND=50
CLAUDE_JOB_RETENTION_DAYS=7
# housekeeping: how often (hours) old Claude jobs and saved Apple cards are cleared, and how long cards are kept (days)
CLAUDE_PRUNE_HOURS=1
# cost estimate: US dollars to euros (a fixed number, not live), optional JSON per-model price overrides in EUR per million tokens
USD_EUR_RATE=0.92
CLAUDE_PRICE_OVERRIDES=
# monthly budget for the API backend in EUR: push at 80 percent, API calls stop at 100 percent; 0 = no limit
CLAUDE_MONTHLY_BUDGET_EUR=0
# tracing (OpenTelemetry GenAI spans): none, console, otlp (otlp needs `uv sync --extra otlp`; endpoint via OTEL_EXPORTER_OTLP_ENDPOINT)
ORBIT_OTEL_EXPORTER=none
BACKUP_PRUNE_HOURS=24
CONTACT_BACKUP_KEEP_DAYS=90
# one-line "what's new with them" in pre-meeting briefs, from the last notes
BRIEF_USE_CLAUDE=true
# the weekly review: from Sunday 19:00 Claude reads last week and the week ahead, writes a review and Inbox proposals
WEEKLY_REVIEW_ENABLED=true
# when it starts: weekday 4 to 6 (Mon is 0; default Sunday) at this local time; a missed one is made until weekday 0 to 3 (default Wednesday)
WEEKLY_REVIEW_WEEKDAY=6
WEEKLY_REVIEW_TIME=19:00
WEEKLY_REVIEW_CATCH_UP_WEEKDAY=2
# size limit of the context snapshot an agent reads, in characters of JSON (about 4 per token)
CONTEXT_BUDGET_CHARS=400000
# optional: how birthday / name-day message drafts should sound, e.g.
#   MESSAGE_STYLE=casual, short, at most one emoji, no exclamation-mark spam
MESSAGE_STYLE=

# --- Notifications (ntfy) ---
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=orbit-change-me-random
NTFY_TOKEN=
QUIET_HOURS=22:00-08:00
# a failed push is tried again after this many minutes, up to this many attempts, and dropped when older than this many hours
NOTIFICATION_RETRY_MINUTES=5
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_MAX_AGE_HOURS=24

# --- Calendar (iCloud CalDAV) ---
CALDAV_URL=https://caldav.icloud.com
CALDAV_USERNAME=
# app-specific password
CALDAV_PASSWORD=
# calendars to read, by the name Apple Calendar shows (case/diacritics don't matter); only these are synced
CALDAV_CALENDARS=Personal,Uni
CALDAV_POLL_MINUTES=10
BRIEF_MINUTES_BEFORE=30
CAPTURE_MINUTES_AFTER=15
# iCloud Contacts sync (one-way, read-only); uses the same username/app-specific password
CARDDAV_URL=https://contacts.icloud.com

# --- Ledger / bank ---
DEFAULT_CURRENCY=EUR
SHARED_MIN_AMOUNT=15.00
ITEM_REMINDER_DAYS=21

# --- Reminders and the digest (SPEC §2.11) ---
# birthday / name-day / lent-item / promise reminders go out from this local time
REMINDER_TIME=09:00
# heads-up for close contacts, days ahead
REMINDER_CLOSE_DAYS_AHEAD=5
# the digest: weekday (Mon is 0; default Sunday) and local time
DIGEST_WEEKDAY=6
DIGEST_TIME=18:00
# optional: printed in "ask to pay" texts (your IBAN and the account holder's name)
PAYMENT_IBAN=
PAYMENT_NAME=

# --- School (SPEC §2.20; see docs/DEPLOY.md "School feeds") ---
# All optional; without them /school says "SIS feed not set up" and manual deadlines still work.
# Secrets in URLs: never paste them anywhere else. Rotating one on SIS/ReCodEx means editing it here.
SIS_BASE_URL=https://sis.example.edu/studium
# SIS Rozvrh -> Export: the auth_key of the iCal link (lessons, with separate teacher lines)
SIS_TIMETABLE_KEY=
# SIS Harmonogram -> Export do kalendáře: the token of the ical.php link (exams, SIS events;
# lessons too when SIS_TIMETABLE_KEY is empty)
SIS_ICAL_TOKEN=
SIS_FEED_TYPES=rozvrhng,term_st2,stev
# minutes, at least 15
SIS_POLL_MINUTES=60
# your faculty id in the SIS, for the public harmonogram
SIS_FACULTY_ID=10000
SIS_COURSE_TTL_DAYS=30
# "tomorrow's lessons" push, local time
SCHOOL_EVENING_TIME=20:00
SCHOOL_PUSHES_ENABLED=true
# exam and deadline reminders: local time, and days before (comma separated)
SCHOOL_REMINDER_TIME=18:00
SCHOOL_EXAM_DAYS=7,1
SCHOOL_DEADLINE_DAYS=3,1
# at most one schedule-change push per this many minutes
SCHOOL_CHANGE_GAP_MINUTES=60
# warn this many days before the ReCodEx token ends
SCHOOL_TOKEN_WARN_DAYS=14
# course pages and PDFs (Phase 18c): checked daily from this local hour; at most this many Claude reads a day
SCHOOL_SITES_HOUR=7
SCHOOL_READS_PER_DAY=20
# where uploaded PDFs are kept; empty = data/school/files (the Docker compose files set /data/school/files)
SCHOOL_FILES_DIR=
RECODEX_BASE_URL=https://recodex.example.edu/api/v1
# ReCodEx profile -> "Deadlines Export to iCal": the token at the end of the link
RECODEX_ICAL_TOKEN=
# ReCodEx profile -> read-only ("read-all") token, 356 days; points, second deadlines, exact course links
RECODEX_API_TOKEN=
OWL_BASE_URL=https://owl.example.edu
# The owl_session cookie of your logged-in browser (DevTools -> Application -> Cookies)
OWL_SESSION_COOKIE=

# --- Backups (the backup service in docker-compose.prod.yml; see docs/DEPLOY.md) ---
# age public key (age1...) backups are encrypted to; its private key stays off the server
BACKUP_AGE_RECIPIENT=
# off-site rclone path: <remote>:<bucket or path>, the remote configured by RCLONE_CONFIG_* below
BACKUP_TARGET=offsite:orbit-backups
# daily, local time (TIMEZONE)
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=90
BACKUP_KEEP_LOCAL_DAYS=7
# rclone remote "offsite" from env vars (no config file), e.g. Backblaze B2:
#   RCLONE_CONFIG_OFFSITE_TYPE=b2
#   RCLONE_CONFIG_OFFSITE_ACCOUNT=<keyID>
#   RCLONE_CONFIG_OFFSITE_KEY=<applicationKey>
# or an SFTP box (password from `rclone obscure <password>`):
#   RCLONE_CONFIG_OFFSITE_TYPE=sftp
#   RCLONE_CONFIG_OFFSITE_HOST=u123456.your-storagebox.de
#   RCLONE_CONFIG_OFFSITE_PORT=23
#   RCLONE_CONFIG_OFFSITE_USER=u123456
#   RCLONE_CONFIG_OFFSITE_PASS=<obscured>

# --- Docker (read by the compose files, not by the app) ---
# Production (docker-compose.prod.yml): the public hostname; ORBIT_URL must be https://<it>
ORBIT_DOMAIN=
# Postgres password, URL-safe characters only (it goes into the database URL);
# docker-compose.prod.yml always uses Postgres
POSTGRES_PASSWORD=
# Local docker-compose.yml only: container DB URL; defaults to SQLite on the orbit-data volume.
# With `--profile postgres`:
#   ORBIT_DOCKER_DATABASE_URL=postgresql+psycopg://orbit:<POSTGRES_PASSWORD>@db:5432/orbit
ORBIT_DOCKER_DATABASE_URL=

# --- Fitness: Liftoff workouts (SPEC §2.35) ---
# Private API; the version is in the host name. After "server is deprecated" put the new host here.
LIFTOFF_API_BASE=https://v2-16-3.api.getgymbros.com
# Google sign-in has no password: capture the refresh token from the app's traffic. Treat it like a password.
LIFTOFF_REFRESH_TOKEN=
# how often the workouts are read, in hours (1 to 168)
LIFTOFF_POLL_HOURS=24
