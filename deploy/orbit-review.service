[Unit]
Description=Orbit weekly review (Claude Code)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# An unprivileged user that has Claude Code installed and its login (see docs/DEPLOY.md §10).
User=orbit-review
ExecStart=/opt/orbit/scripts/weekly-review.sh
StateDirectory=orbit-review
Environment=ORBIT_REVIEW_ENV=/etc/orbit-review.env
# The VM is small: keep Claude Code from starving Postgres and the app.
MemoryMax=600M
Nice=10
TimeoutStartSec=30min
